name: Manter Supabase ativo

on:
  schedule:
    # Roda toda segunda-feira às 09:00 (horário de Brasília = 12:00 UTC)
    - cron: "0 12 * * 1"
  workflow_dispatch: {}  # permite rodar manualmente pelo botão "Run workflow" no GitHub

jobs:
  ping-supabase:
    runs-on: ubuntu-latest
    steps:
      - name: Fazer uma query simples via API REST do Supabase
        run: |
          curl -s -o /dev/null -w "Status: %{http_code}\n" \
            "https://blczadrtgbgkrjewbqxo.supabase.co/rest/v1/avaliacoes_lider?select=id&limit=1" \
            -H "apikey: ${{ secrets.SUPABASE_ANON_KEY }}" \
            -H "Authorization: Bearer ${{ secrets.SUPABASE_ANON_KEY }}"
